HUGGINGFACE_API_KEY=your_huggingface_api_key_here
AGENT_MODE=deterministic
NEO4J_URI=neo4j+s://your_neoj4_database_id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
TRAVEL_CLIENT_ID=your_travel_client_id_here
TRAVEL_CLIENT_SECRET=your_travel_client_secret_here
FLIGHT_DATA_MODE=google_flights
ALLOW_MOCK_FLIGHT_FALLBACK=true
FLIGHT_SEARCH_CACHE_SECONDS=600
FLIGHT_SEARCH_RESULT_LIMIT=8
